# Copy to .env and adjust. Never commit .env.

# ---- Logging -------------------------------------------------------------
LOG_LEVEL=INFO

# ---- Hadith sources ------------------------------------------------------
# Tried in order; the first one with a confident match answers.
# Known names: dorar, offline
SOURCES=dorar,offline
DORAR_BASE_URL=https://dorar.net/dorar_api.json
DORAR_TIMEOUT_SECONDS=10
DORAR_RETRY_BACKOFF_SECONDS=0.5
# majority = verdict given by most scholars in the results; first = first definite result
DORAR_PRIMARY_RULE=majority
# Where the six-books dataset is cached (docker-compose overrides this to /data/hadith)
OFFLINE_DATA_DIR=data/hadith
OFFLINE_BASE_URL=https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions/
OFFLINE_DOWNLOAD_TIMEOUT_SECONDS=180

# ---- OpenAI (optional) ---------------------------------------------------
# Leave the key empty to run without any LLM call (explanation_ar is then null).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=8

# ---- Prayer times (Aladhan) ----------------------------------------------
ALADHAN_BASE_URL=https://api.aladhan.com/v1
ALADHAN_TIMEOUT_SECONDS=10
# 5 = Egyptian General Authority of Survey
PRAYER_DEFAULT_METHOD=5

# ---- API behaviour -------------------------------------------------------
# Comma-separated origins, or * for any
CORS_ORIGINS=*
# Comma-separated keys accepted in X-API-Key. Empty = authentication disabled.
API_KEYS=
# Requests per IP per minute. 0 = disabled.
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000

# ---- docker compose only -------------------------------------------------
API_PORT=8000
UI_PORT=8501
# Set to one of API_KEYS when authentication is enabled, so the demo UI can call the API.
UI_API_KEY=
